# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NUNCA vai para o Git.

# development | production | testing
APP_ENV=development

# Chave para assinar sessões. Em produção use um valor longo e aleatório:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Postgres via docker-compose (porta 5433 para não bater com um Postgres local).
# Deixe esta linha VAZIA ou apagada para usar um SQLite local (dev.db),
# que não precisa instalar nada: bom para quem só mexe no front.
DATABASE_URL=postgresql://loja:loja123@localhost:5433/loja_ceramica

# WhatsApp da loja: só números, com código do país (55) e DDD (12).
# Todos os links de WhatsApp do site saem daqui, pela função whatsapp_link().
WHATSAPP_NUMBER=5512991399090

# Nome exibido no site (título das abas, rodapé, leitores de tela)
SITE_NAME="Malosti Arte Cerâmica"

# Link do Google Forms de inscrição nos cursos
COURSES_FORM_URL=#

# ---------- Fotos: local (disco) ou cloudinary (produção) ----------
# Hospedagens em nuvem costumam apagar arquivos enviados a cada deploy: em produção use cloudinary.
STORAGE_FOTOS=local
# cloudinary.com > Settings > API Keys (Cloud name, API Key, API Secret). Só no .env do servidor.
CLOUDINARY_CLOUD_NAME=coloque-aqui-o-cloud-name
CLOUDINARY_API_KEY=coloque-aqui-a-api-key
CLOUDINARY_API_SECRET=coloque-aqui-o-api-secret
CLOUDINARY_PASTA=julia-malosti/produtos

# ---------- Pagamento: Mercado Pago (Checkout Pro) ----------
# Credenciais de TESTE em mercadopago.com.br/developers > Suas integrações > (app) > Credenciais de teste.
# Nunca coloque a chave aqui no exemplo nem no chat: só no .env do servidor.
MP_ACCESS_TOKEN=coloque-aqui-o-access-token-de-teste
# Suas integrações > (app) > Webhooks > Configurar notificações > Assinatura secreta
MP_WEBHOOK_SECRET=coloque-aqui-a-assinatura-secreta
# Endereço público do site, com https e sem barra no fim (o Mercado Pago não aceita localhost)
SITE_URL=https://seu-dominio.com.br
# ---------- E-mail: Brevo (recuperação de senha e avisos de pedido) ----------
# brevo.com > SMTP e API > Chaves de API. Só no .env do servidor, nunca no Git nem no chat.
# Sem a chave o site funciona igual, só não envia e-mails (em dev o texto aparece no terminal).
BREVO_API_KEY=coloque-aqui-a-chave-da-api-v3
# Remetente VERIFICADO no Brevo (Remetentes e IPs). Ideal: um e-mail do domínio da loja.
EMAIL_REMETENTE=loja@seu-dominio.com.br
EMAIL_REMETENTE_NOME="Malosti Arte Cerâmica"
# Para onde vai o aviso de "novo pedido pago" (e-mail da Julia). Vazio = sem aviso.
EMAIL_AVISO_PEDIDOS=
