# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NUNCA vai para o Git.

# development | production | testing
APP_ENV=development

# Chave para assinar sessões. Em produção use um valor longo e aleatório:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Postgres via docker-compose (porta 5433 para não bater com um Postgres local).
# Deixe esta linha VAZIA ou apagada para usar um SQLite local (dev.db),
# que não precisa instalar nada: bom para quem só mexe no front.
DATABASE_URL=postgresql://loja:loja123@localhost:5433/loja_ceramica

# WhatsApp da loja: só números, com código do país e DDD (ex.: 5512999999999)
WHATSAPP_NUMBER=5512999999999

# Nome exibido no site
SITE_NAME=Loja de Cerâmica

# Link do Google Forms de inscrição nos cursos
COURSES_FORM_URL=#
